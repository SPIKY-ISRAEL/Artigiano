{% doc %}
  @prompt
    a sale pop up, an image only with a button on to of it
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sale-popup-{{ ai_gen_id }} {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-sale-popup-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-sale-popup-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
  }

  .ai-sale-popup-content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: {{ block.settings.popup_width }}px;
    width: 90%;
    max-height: 90vh;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-sale-popup-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: auto;
  }

  .ai-sale-popup-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-sale-popup-placeholder-{{ ai_gen_id }} {
    width: 100%;
    min-height: 400px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-sale-popup-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-sale-popup-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-sale-popup-button-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.button_vertical_position }}%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .ai-sale-popup-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
  }

  .ai-sale-popup-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-sale-popup-close-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.close_button_position }}px;
    right: {{ block.settings.close_button_position }}px;
    width: {{ block.settings.close_button_size }}px;
    height: {{ block.settings.close_button_size }}px;
    background-color: {{ block.settings.close_button_background }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: all 0.3s ease;
  }

  .ai-sale-popup-close-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.close_button_hover_background }};
  }

  .ai-sale-popup-close-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.close_button_size }}px * 0.5);
    height: calc({{ block.settings.close_button_size }}px * 0.5);
    stroke: {{ block.settings.close_button_icon_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-sale-popup-content-{{ ai_gen_id }} {
      max-width: 95%;
    }

    .ai-sale-popup-button-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_font_size }}px * 0.9);
      padding: calc({{ block.settings.button_padding_vertical }}px * 0.8) calc({{ block.settings.button_padding_horizontal }}px * 0.8);
    }
  }
{% endstyle %}

<sale-popup-{{ ai_gen_id }}
  class="ai-sale-popup-{{ ai_gen_id }}"
  data-delay="{{ block.settings.delay }}"
  data-show-once="{{ block.settings.show_once }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-sale-popup-overlay-{{ ai_gen_id }}"></div>
  
  <div class="ai-sale-popup-content-{{ ai_gen_id }}">
    <button
      class="ai-sale-popup-close-{{ ai_gen_id }}"
      aria-label="Close popup"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="ai-sale-popup-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.popup_image %}
        <img
          src="{{ block.settings.popup_image | image_url: width: 1200 }}"
          alt="{{ block.settings.popup_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.popup_image.width }}"
          height="{{ block.settings.popup_image.height }}"
          class="ai-sale-popup-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-sale-popup-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-sale-popup-empty-state-{{ ai_gen_id }}">
            Add a sale image to get started
          </div>
        </div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <div class="ai-sale-popup-button-wrapper-{{ ai_gen_id }}">
          <a
            href="{{ block.settings.button_link }}"
            class="ai-sale-popup-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</sale-popup-{{ ai_gen_id }}>

<script>
  (function() {
    class SalePopup{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.delay = parseInt(this.dataset.delay) * 1000;
        this.showOnce = this.dataset.showOnce === 'true';
        this.cookieName = 'ai_sale_popup_{{ ai_gen_id }}_shown';
      }

      connectedCallback() {
        this.closeButton = this.querySelector('.ai-sale-popup-close-{{ ai_gen_id }}');
        this.overlay = this.querySelector('.ai-sale-popup-overlay-{{ ai_gen_id }}');
        
        this.setupEventListeners();
        this.checkAndShowPopup();
      }

      setupEventListeners() {
        this.closeButton.addEventListener('click', () => this.closePopup());
        this.overlay.addEventListener('click', () => this.closePopup());
        
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.classList.contains('active')) {
            this.closePopup();
          }
        });
      }

      checkAndShowPopup() {
        if (this.showOnce && this.getCookie(this.cookieName)) {
          return;
        }

        setTimeout(() => {
          this.showPopup();
        }, this.delay);
      }

      showPopup() {
        this.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      closePopup() {
        this.classList.remove('active');
        document.body.style.overflow = '';
        
        if (this.showOnce) {
          this.setCookie(this.cookieName, 'true', 30);
        }
      }

      setCookie(name, value, days) {
        const date = new Date();
        date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
        const expires = 'expires=' + date.toUTCString();
        document.cookie = name + '=' + value + ';' + expires + ';path=/';
      }

      getCookie(name) {
        const nameEQ = name + '=';
        const ca = document.cookie.split(';');
        for (let i = 0; i < ca.length; i++) {
          let c = ca[i];
          while (c.charAt(0) === ' ') c = c.substring(1, c.length);
          if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
        }
        return null;
      }
    }

    customElements.define('sale-popup-{{ ai_gen_id }}', SalePopup{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Sale popup",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Popup image"
    },
    {
      "type": "image_picker",
      "id": "popup_image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "popup_width",
      "label": "Popup width",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "button_vertical_position",
      "label": "Vertical position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Font size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Horizontal padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Vertical padding",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Background",
      "default": "#015555"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Hover background",
      "default": "#272727"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Close button"
    },
    {
      "type": "range",
      "id": "close_button_size",
      "label": "Size",
      "min": 24,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "close_button_position",
      "label": "Position from edge",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "close_button_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "close_button_hover_background",
      "label": "Hover background",
      "default": "#f2f2f2"
    },
    {
      "type": "color",
      "id": "close_button_icon_color",
      "label": "Icon color",
      "default": "#272727"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.5
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Delay before showing",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_once",
      "label": "Show only once per visitor",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Sale popup"
    }
  ]
}
{% endschema %}
