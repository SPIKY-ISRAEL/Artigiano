{% doc %}
  @prompt
    I want to create a custom FAQ section.
    
    The section should include:
    
    A main heading
    Option to control text alignment separately for desktop and mobile
    Option to choose font sizes for desktop and mobile
    
    The heading should also support separate text alignment settings for desktop and mobile.
    
    For the FAQ items:
    
    Each item should display a question with a dropdown arrow icon next to it
    When clicked, the answer should expand/collapse like an accordion
    
    Customization options should include:
    
    Colors
    Border radius / rounded corners
    Spacing and padding controls
    
    I also want the ability to add a subtitle text box below the entire FAQ section.
    
    The section should be fully responsive and optimized for both desktop and mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-section-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-faq-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_font_size_desktop }}px;
    line-height: 1.2;
    {% if block.settings.heading_alignment_desktop == 'left' %}
      text-align: left;
    {% elsif block.settings.heading_alignment_desktop == 'center' %}
      text-align: center;
    {% else %}
      text-align: right;
    {% endif %}
  }

  .ai-faq-items-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.items_gap }}px;
  }

  .ai-faq-item-{{ ai_gen_id }} {
    background-color: {{ block.settings.item_background_color }};
    border: {{ block.settings.item_border_width }}px solid {{ block.settings.item_border_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    overflow: hidden;
  }

  .ai-faq-question-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: {{ block.settings.question_padding_vertical }}px {{ block.settings.question_padding_horizontal }}px;
    background-color: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.3s ease;
  }

  .ai-faq-question-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.item_hover_background_color }};
  }

  .ai-faq-question-text-{{ ai_gen_id }} {
    flex: 1;
    color: {{ block.settings.question_color }};
    font-size: {{ block.settings.question_font_size_desktop }}px;
    font-weight: 600;
    line-height: 1.4;
  }

  .ai-faq-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    transition: transform 0.3s ease;
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-faq-answer-wrapper-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-faq-answer-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.question_padding_horizontal }}px {{ block.settings.answer_padding_bottom }}px;
    color: {{ block.settings.answer_color }};
    font-size: {{ block.settings.answer_font_size_desktop }}px;
    line-height: 1.6;
  }

  .ai-faq-subtitle-{{ ai_gen_id }} {
    margin-top: {{ block.settings.subtitle_margin_top }}px;
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_font_size_desktop }}px;
    line-height: 1.5;
    {% if block.settings.subtitle_alignment_desktop == 'left' %}
      text-align: left;
    {% elsif block.settings.subtitle_alignment_desktop == 'center' %}
      text-align: center;
    {% else %}
      text-align: right;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-faq-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-faq-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size_mobile }}px;
      {% if block.settings.heading_alignment_mobile == 'left' %}
        text-align: left;
      {% elsif block.settings.heading_alignment_mobile == 'center' %}
        text-align: center;
      {% else %}
        text-align: right;
      {% endif %}
    }

    .ai-faq-question-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.question_font_size_mobile }}px;
    }

    .ai-faq-answer-{{ ai_gen_id }} {
      font-size: {{ block.settings.answer_font_size_mobile }}px;
    }

    .ai-faq-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_font_size_mobile }}px;
      {% if block.settings.subtitle_alignment_mobile == 'left' %}
        text-align: left;
      {% elsif block.settings.subtitle_alignment_mobile == 'center' %}
        text-align: center;
      {% else %}
        text-align: right;
      {% endif %}
    }
  }
{% endstyle %}

<faq-accordion-{{ ai_gen_id }} class="ai-faq-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
