{% doc %}
  @prompt
    I want to create a fully customizable FAQ section for my Shopify store.
    The section should include:
    
    
    A main heading
    
    
    A subtitle/description area below the FAQ items
    
    
    Fully responsive layout optimized for desktop and mobile
    
    
    Customization settings should include:
    Heading Settings
    
    
    Separate text alignment controls for desktop and mobile
    
    
    Font size controls for desktop and mobile
    
    
    Color controls
    
    
    Margin and spacing controls
    
    
    FAQ Item Settings
    Each FAQ item should include:
    
    
    A question row
    
    
    A dropdown arrow icon next to the question
    
    
    Expand/collapse accordion behavior when clicked
    
    
    A smooth opening/closing animation
    
    
    Question & Answer Controls
    Please allow separate controls for:
    
    
    Text alignment on desktop and mobile
    
    
    Text direction (LTR / RTL)
    
    
    Indentation / padding
    
    
    Font size
    
    
    Font weight
    
    
    Text colors
    
    
    for both:
    
    
    Questions
    
    
    Answers
    
    
    Design Customization
    Please include options for:
    
    
    Background colors
    
    
    Border colors
    
    
    Border radius / rounded corners
    
    
    Spacing between FAQ items
    
    
    Padding controls
    
    
    Hover effects
    
    
    Icon size and icon color
    
    
    Additional Requirements
    
    
    The section should support RTL languages like Hebrew
    
    
    The FAQ items should be manageable as repeatable blocks inside Shopify Theme Editor
    
    
    The design should look clean, modern, and minimal
    
    
    Mobile responsiveness is very important
    
    
    The section should be easy to customize directly from the Shopify editor without coding
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-item-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-faq-question-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: {{ block.settings.question_padding_mobile }}px;
    background-color: {{ block.settings.question_bg_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease;
    direction: {{ block.settings.text_direction }};
  }

  .ai-faq-question-wrapper-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.question_hover_bg_color }};
    border-color: {{ block.settings.border_hover_color }};
  }

  .ai-faq-question-{{ ai_gen_id }} {
    flex: 1;
    margin: 0;
    font-size: {{ block.settings.question_font_size_mobile }}px;
    font-weight: {{ block.settings.question_font_weight }};
    color: {{ block.settings.question_color }};
    text-align: {{ block.settings.question_alignment_mobile }};
    line-height: 1.5;
  }

  .ai-faq-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    transition: transform 0.3s ease;
    color: {{ block.settings.icon_color }};
  }

  .ai-faq-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-faq-answer-wrapper-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, padding 0.4s ease;
    background-color: {{ block.settings.answer_bg_color }};
    border-left: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-right: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: 0 0 {{ block.settings.border_radius }}px {{ block.settings.border_radius }}px;
    direction: {{ block.settings.text_direction }};
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-answer-wrapper-{{ ai_gen_id }} {
    max-height: 1000px;
    padding: {{ block.settings.answer_padding_mobile }}px;
  }

  .ai-faq-answer-{{ ai_gen_id }} {
    font-size: {{ block.settings.answer_font_size_mobile }}px;
    font-weight: {{ block.settings.answer_font_weight }};
    color: {{ block.settings.answer_color }};
    text-align: {{ block.settings.answer_alignment_mobile }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .ai-faq-question-wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.question_padding_desktop }}px;
    }

    .ai-faq-question-{{ ai_gen_id }} {
      font-size: {{ block.settings.question_font_size_desktop }}px;
      text-align: {{ block.settings.question_alignment_desktop }};
    }

    .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-answer-wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.answer_padding_desktop }}px;
    }

    .ai-faq-answer-{{ ai_gen_id }} {
      font-size: {{ block.settings.answer_font_size_desktop }}px;
      text-align: {{ block.settings.answer_alignment_desktop }};
    }
  }
{% endstyle %}

<faq-item-{{ ai_gen_id }} class="ai-faq-item-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-faq-question-wrapper-{{ ai_gen_id }}" role="button" aria-expanded="false" tabindex="0">
    <h3 class="ai-faq-question-{{ ai_gen_id }}">{{ block.settings.question }}</h3>
    <div class="ai-faq-icon-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  </div>
  <div class="ai-faq-answer-wrapper-{{ ai_gen_id }}">
    <div class="ai-faq-answer-{{ ai_gen_id }}">{{ block.settings.answer }}</div>
  </div>
</faq-item-{{ ai_gen_id }}>

<script>
  (function() {
    class FaqItem{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.questionWrapper = this.querySelector('.ai-faq-question-wrapper-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.questionWrapper.addEventListener('click', () => this.toggle());
        this.questionWrapper.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            this.toggle();
          }
        });
      }

      toggle() {
        const isActive = this.classList.contains('active');
        this.classList.toggle('active');
        this.questionWrapper.setAttribute('aria-expanded', !isActive);
      }
    }

    customElements.define('faq-item-{{ ai_gen_id }}', FaqItem{{ ai_gen_id }});
  })();
</script>

