{% doc %}
  @prompt
    I want to create a custom FAQ section.
    The section should include:
    
    
    A main heading
    
    
    Option to control text alignment separately for desktop and mobile
    
    
    Option to choose font sizes for desktop and mobile
    
    
    The heading should also support separate text alignment settings for desktop and mobile.
    For the FAQ items:
    
    
    Each item should display a question with a dropdown arrow icon next to it
    
    
    When clicked, the answer should expand/collapse like an accordion
    
    
    Customization options should include:
    
    
    Colors
    
    
    Border radius / rounded corners
    
    
    Spacing and padding controls
    
    
    I also want the ability to add a subtitle text box below the entire FAQ section.
    The section should be fully responsive and optimized for both desktop and mobile.
    Also, please allow separate text alignment and indentation controls for the questions and answers themselves, for both desktop and mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-section-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_desktop }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-faq-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_bottom_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_font_size_desktop }}px;
    text-align: {{ block.settings.heading_alignment_desktop }};
  }

  .ai-faq-subtitle-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.subtitle_bottom_spacing }}px;
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_font_size_desktop }}px;
    text-align: {{ block.settings.subtitle_alignment_desktop }};
  }

  .ai-faq-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-faq-item-{{ ai_gen_id }} {
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.item_background_color }};
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .ai-faq-item-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.item_hover_background_color }};
  }

  .ai-faq-question-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ block.settings.question_padding_desktop }}px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: {{ block.settings.question_alignment_desktop }};
    gap: 16px;
  }

  .ai-faq-question-text-{{ ai_gen_id }} {
    flex: 1;
    color: {{ block.settings.question_color }};
    font-size: {{ block.settings.question_font_size_desktop }}px;
    font-weight: {{ block.settings.question_font_weight }};
    margin: 0;
    padding-left: {{ block.settings.question_indent_desktop }}px;
  }

  .ai-faq-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    transition: transform 0.3s ease;
    color: {{ block.settings.icon_color }};
  }

  .ai-faq-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-faq-answer-wrapper-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-faq-answer-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.answer_padding_desktop }}px {{ block.settings.answer_padding_desktop }}px;
    color: {{ block.settings.answer_color }};
    font-size: {{ block.settings.answer_font_size_desktop }}px;
    text-align: {{ block.settings.answer_alignment_desktop }};
    padding-left: calc({{ block.settings.answer_padding_desktop }}px + {{ block.settings.answer_indent_desktop }}px);
  }

  .ai-faq-bottom-subtitle-{{ ai_gen_id }} {
    margin: {{ block.settings.bottom_subtitle_top_spacing }}px 0 0;
    color: {{ block.settings.bottom_subtitle_color }};
    font-size: {{ block.settings.bottom_subtitle_font_size_desktop }}px;
    text-align: {{ block.settings.bottom_subtitle_alignment_desktop }};
  }

  @media screen and (max-width: 749px) {
    .ai-faq-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_mobile }}px;
    }

    .ai-faq-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size_mobile }}px;
      text-align: {{ block.settings.heading_alignment_mobile }};
    }

    .ai-faq-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_font_size_mobile }}px;
      text-align: {{ block.settings.subtitle_alignment_mobile }};
    }

    .ai-faq-question-{{ ai_gen_id }} {
      padding: {{ block.settings.question_padding_mobile }}px;
      text-align: {{ block.settings.question_alignment_mobile }};
    }

    .ai-faq-question-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.question_font_size_mobile }}px;
      padding-left: {{ block.settings.question_indent_mobile }}px;
    }

    .ai-faq-answer-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.answer_padding_mobile }}px {{ block.settings.answer_padding_mobile }}px;
      font-size: {{ block.settings.answer_font_size_mobile }}px;
      text-align: {{ block.settings.answer_alignment_mobile }};
      padding-left: calc({{ block.settings.answer_padding_mobile }}px + {{ block.settings.answer_indent_mobile }}px);
    }

    .ai-faq-bottom-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.bottom_subtitle_font_size_mobile }}px;
      text-align: {{ block.settings.bottom_subtitle_alignment_mobile }};
    }
  }
{% endstyle %}

<faq-accordion-{{ ai_gen_id }} class="ai-faq-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-faq-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  {% if block.settings.subtitle != blank %}
    <div class="ai-faq-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
  {% endif %}

  <div class="ai-faq-container-{{ ai_gen_id }}">
    {% for i in (1..10) %}
      {% assign question_key = 'question_' | append: i %}
      {% assign answer_key = 'answer_' | append: i %}
      {% assign question = block.settings[question_key] %}
      {% assign answer = block.settings[answer_key] %}

      {% if question != blank %}
        <div class="ai-faq-item-{{ ai_gen_id }}" data-faq-item>
          <button
            class="ai-faq-question-{{ ai_gen_id }}"
            aria-expanded="false"
            data-faq-button
          >
            <h3 class="ai-faq-question-text-{{ ai_gen_id }}">{{ question }}</h3>
            <span class="ai-faq-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div class="ai-faq-answer-wrapper-{{ ai_gen_id }}" data-faq-answer>
            <div class="ai-faq-answer-{{ ai_gen_id }}">{{ answer }}</div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if block.settings.bottom_subtitle != blank %}
    <div class="ai-faq-bottom-subtitle-{{ ai_gen_id }}">{{ block.settings.bottom_subtitle }}</div>
  {% endif %}
</faq-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    class FaqAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.items = [];
      }

      connectedCallback() {
        this.items = Array.from(this.querySelectorAll('[data-faq-item]'));
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.items.forEach((item) => {
          const button = item.querySelector('[data-faq-button]');
          const answerWrapper = item.querySelector('[data-faq-answer]');
          const answer = answerWrapper.querySelector('.ai-faq-answer-{{ ai_gen_id }}');

          button.addEventListener('click', () => {
            const isActive = item.classList.contains('active');

            if (isActive) {
              this.closeItem(item, button, answerWrapper);
            } else {
              this.openItem(item, button, answerWrapper, answer);
            }
          });
        });
      }

      openItem(item, button, answerWrapper, answer) {
        item.classList.add('active');
        button.setAttribute('aria-expanded', 'true');
        answerWrapper.style.maxHeight = answer.scrollHeight + 'px';
      }

      closeItem(item, button, answerWrapper) {
        item.classList.remove('active');
        button.setAttribute('aria-expanded', 'false');
        answerWrapper.style.maxHeight = '0';
      }
    }

    customElements.define('faq-accordion-{{ ai_gen_id }}', FaqAccordion{{ ai_gen_id }});
  })();
</script>

