{% doc %}
  @prompt
    a sale pop up with only image, and button on top of it, with an option to adjust the place of the button on the image
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sale-popup-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-sale-popup-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-sale-popup-content-{{ ai_gen_id }} {
    position: relative;
    max-width: {{ block.settings.popup_max_width }}px;
    width: 90%;
    background-color: {{ block.settings.popup_background }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
  }

  .ai-sale-popup-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: auto;
  }

  .ai-sale-popup-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-sale-popup-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-sale-popup-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-sale-popup-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-sale-popup-button-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: var(--ai-button-y-{{ ai_gen_id }});
    left: var(--ai-button-x-{{ ai_gen_id }});
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .ai-sale-popup-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
    white-space: nowrap;
  }

  .ai-sale-popup-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: scale(1.05);
  }

  .ai-sale-popup-close-{{ ai_gen_id }} {
    position: absolute;
    top: 15px;
    right: 15px;
    width: 40px;
    height: 40px;
    background-color: {{ block.settings.close_button_background }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: all 0.3s ease;
    padding: 0;
  }

  .ai-sale-popup-close-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.close_button_hover_background }};
    transform: scale(1.1);
  }

  .ai-sale-popup-close-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.close_button_icon_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-sale-popup-content-{{ ai_gen_id }} {
      width: 95%;
    }

    .ai-sale-popup-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }

    .ai-sale-popup-close-{{ ai_gen_id }} {
      width: 35px;
      height: 35px;
      top: 10px;
      right: 10px;
    }
  }
{% endstyle %}

<sale-popup-{{ ai_gen_id }}
  class="ai-sale-popup-{{ ai_gen_id }}"
  data-delay="{{ block.settings.popup_delay }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-sale-popup-content-{{ ai_gen_id }}">
    <button
      class="ai-sale-popup-close-{{ ai_gen_id }}"
      aria-label="Close popup"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="ai-sale-popup-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.popup_image %}
        <img
          src="{{ block.settings.popup_image | image_url: width: 1200 }}"
          alt="{{ block.settings.popup_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.popup_image.width }}"
          height="{{ block.settings.popup_image.height }}"
          class="ai-sale-popup-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-sale-popup-image-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-sale-popup-empty-state-{{ ai_gen_id }}">
            Next, add a sale image
          </div>
        </div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <div
          class="ai-sale-popup-button-wrapper-{{ ai_gen_id }}"
          style="
            --ai-button-x-{{ ai_gen_id }}: {{ block.settings.button_position_x }}%;
            --ai-button-y-{{ ai_gen_id }}: {{ block.settings.button_position_y }}%;
          "
        >
          <a
            href="{{ block.settings.button_link }}"
            class="ai-sale-popup-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</sale-popup-{{ ai_gen_id }}>

<script>
  (function() {
    class SalePopup{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.hasBeenShown = false;
      }

      connectedCallback() {
        this.closeButton = this.querySelector('.ai-sale-popup-close-{{ ai_gen_id }}');
        this.overlay = this;
        this.delay = parseInt(this.dataset.delay) * 1000;

        this.setupEventListeners();
        this.checkAndShowPopup();
      }

      setupEventListeners() {
        this.closeButton.addEventListener('click', () => {
          this.closePopup();
        });

        this.overlay.addEventListener('click', (event) => {
          if (event.target === this.overlay) {
            this.closePopup();
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && this.classList.contains('active')) {
            this.closePopup();
          }
        });
      }

      checkAndShowPopup() {
        const popupShown = sessionStorage.getItem('ai-sale-popup-{{ ai_gen_id }}-shown');

        if (!popupShown && !this.hasBeenShown) {
          setTimeout(() => {
            this.showPopup();
          }, this.delay);
        }
      }

      showPopup() {
        this.classList.add('active');
        this.hasBeenShown = true;
        document.body.style.overflow = 'hidden';
      }

      closePopup() {
        this.classList.remove('active');
        document.body.style.overflow = '';
        sessionStorage.setItem('ai-sale-popup-{{ ai_gen_id }}-shown', 'true');
      }
    }

    customElements.define('sale-popup-{{ ai_gen_id }}', SalePopup{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Sale popup",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Popup settings"
    },
    {
      "type": "range",
      "id": "popup_delay",
      "label": "Delay before showing",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 2
    },
    {
      "type": "range",
      "id": "popup_max_width",
      "label": "Maximum width",
      "min": 400,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 700
    },
    {
      "type": "color",
      "id": "popup_background",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "popup_image",
      "label": "Sale image"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "button_position_x",
      "label": "Horizontal position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "button_position_y",
      "label": "Vertical position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Font size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Horizontal padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Vertical padding",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Background color",
      "default": "#015555"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Hover background color",
      "default": "#272727"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Close button"
    },
    {
      "type": "color",
      "id": "close_button_background",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "close_button_hover_background",
      "label": "Hover background color",
      "default": "#f2f2f2"
    },
    {
      "type": "color",
      "id": "close_button_icon_color",
      "label": "Icon color",
      "default": "#272727"
    }
  ],
  "presets": [
    {
      "name": "Sale popup"
    }
  ]
}
{% endschema %}
